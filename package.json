{
  "name": "@bosdev/zaps",
  "version": "0.8.0",
  "description": "Zero Ass Pain Setup — a tmux-based dev environment orchestrator: define services, dependencies, tasks, and layout in one config file, with ready detection, crash recovery, and a keyboard-driven TUI.",
  "keywords": [
    "cli",
    "dev-environment",
    "developer-tools",
    "ink",
    "process-manager",
    "react",
    "service-orchestrator",
    "tmux",
    "tui"
  ],
  "homepage": "https://github.com/boshold/zaps#readme",
  "bugs": {
    "url": "https://github.com/boshold/zaps/issues"
  },
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshold/zaps.git"
  },
  "bin": {
    "zaps": "./bin/zaps"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "bin",
    ".claude/skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/config/index.d.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsx scripts/build.ts",
    "build:native": "bun run scripts/build-native.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c test/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check; oxlint --type-aware --deny-warnings",
    "lint:fix": "oxfmt --write; oxlint --fix --fix-suggestions --fix-dangerously --deny-warnings --type-aware",
    "check": "pnpm typecheck && pnpm lint:fix && pnpm build && pnpm build:native && pnpm test:coverage"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@toon-format/toon": "^4.1.1",
    "@types/node": "^26.6.3",
    "cleye": "^2.7.0",
    "fuzzysort": "^4.0.2",
    "ink": "^8.0.0",
    "jiti": "^2.7.0",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bosdev/sentra-core": "^0.1.1",
    "@sentry/node": "^11.2.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-devtools-core": "^8.0.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
