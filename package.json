{
  "name": "@bosdev/zaps",
  "version": "0.8.0",
  "description": "Zero Ass Pain Setup — a tmux-based dev environment orchestrator: define services, dependencies, tasks, and layout in one config file, with ready detection, crash recovery, and a keyboard-driven TUI.",
  "keywords": [
    "cli",
    "dev-environment",
    "developer-tools",
    "ink",
    "process-manager",
    "react",
    "service-orchestrator",
    "tmux",
    "tui"
  ],
  "homepage": "https://github.com/boshold/zaps#readme",
  "bugs": {
    "url": "https://github.com/boshold/zaps/issues"
  },
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshold/zaps.git"
  },
  "bin": {
    "zaps": "./bin/zaps"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "bin",
    ".claude/skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/config/index.d.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsx scripts/build.ts",
    "build:native": "bun run scripts/build-native.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c test/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check; oxlint --type-aware --deny-warnings",
    "lint:fix": "oxfmt --write; oxlint --fix --fix-suggestions --fix-dangerously --deny-warnings --type-aware",
    "check": "pnpm typecheck && pnpm lint:fix && pnpm build && pnpm build:native && pnpm test:coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "^2.3.0",
    "@types/node": "^26.0.0",
    "commander": "^15.0.0",
    "fuzzysort": "^3.1.0",
    "ink": "^7.0.5",
    "jiti": "^2.7.0",
    "open": "^11.0.0",
    "react": "^19.2.7",
    "tsx": "^4.22.4",
    "yoga-layout": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "react-devtools-core": "^7.0.1",
    "testcontainers": "^12.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
