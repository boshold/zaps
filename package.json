{
  "name": "@bosdev/zaps",
  "version": "0.15.0",
  "description": "Zero Ass Pain Setup: orchestrate dev services with tmux or a background shell backend, readiness, logs, tasks, and a keyboard-driven TUI.",
  "keywords": [
    "cli",
    "dev-environment",
    "developer-tools",
    "ink",
    "process-manager",
    "react",
    "service-orchestrator",
    "tmux",
    "tui"
  ],
  "homepage": "https://github.com/boshold/zaps#readme",
  "bugs": {
    "url": "https://github.com/boshold/zaps/issues"
  },
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshold/zaps.git"
  },
  "bin": {
    "zaps": "./bin/zaps"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "bin",
    ".claude/skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/config/index.d.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsx scripts/build.ts",
    "build:native": "bun run scripts/build-native.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c test/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check && oxlint --type-aware --deny-warnings",
    "lint:fix": "oxfmt --write && oxlint --fix --fix-suggestions --fix-dangerously --deny-warnings --type-aware",
    "check": "pnpm typecheck && pnpm lint:fix && pnpm build && pnpm build:native && pnpm test:coverage",
    "test:integration:shell": "vitest run -c test/integration/shell/vitest.config.ts"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@toon-format/toon": "^4.4.0",
    "@types/node": "^26.6.6",
    "cleye": "^2.7.0",
    "fuzzysort": "^4.0.2",
    "ink": "^8.0.0",
    "jiti": "^2.7.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bosdev/sentra-core": "^0.1.1",
    "@sentry/node": "^11.11.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react-devtools-core": "^8.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
